{
  "redirects": [
    {
      "source": "/blog/caso-pintureria-cinco-sucursales",
      "destination": "/casos/pintureria-cinco-sucursales",
      "permanent": true
    },
    {
      "source": "/blog/caso-club-deportivo-cuotas",
      "destination": "/casos/club-deportivo-cuotas",
      "permanent": true
    },
    {
      "source": "/blog/caso-portal-b2b-bodega",
      "destination": "/casos/portal-b2b-bodega",
      "permanent": true
    },
    {
      "source": "/blog/caso-concil-producto-propio",
      "destination": "/casos/concil-producto-propio",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/casos/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
